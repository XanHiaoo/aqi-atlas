.tabbar{position:fixed;z-index:90;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-around;padding:14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));border-top:1px solid #e0e8f0;background:#fff}.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;min-height:96rpx;margin:0 3rpx;border-radius:22rpx;color:#6f8497;font-size:22rpx}.active{color:#1f659b;background:#edf5fd;font-weight:600}.icon{width:42rpx;height:42rpx}
