<view wx:if="{{!hidden}}" class="tabbar"><view wx:for="{{tabs}}" wx:key="page" class="tab {{selected === index ? 'active' : ''}}" bindtap="switchTab" data-index="{{index}}" role="button" aria-label="{{item.label}}"><image class="icon" src="/assets/{{item.icon}}{{selected === index ? '-active' : ''}}.png"/><text>{{item.label}}</text></view></view>
