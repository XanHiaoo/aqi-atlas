<template name="legend"><view class="aqi-legend"><view wx:for="{{legend}}" wx:key="name" class="legend-item"><view class="swatch" style="background:{{item.gradient}}"></view><text>{{item.name}} {{item.range}}</text></view><view class="legend-item"><view class="missing-swatch"></view><text>缺失</text></view></view></template>
<template name="months"><view class="year-grid"><view wx:for="{{months}}" wx:for-item="month" wx:key="key" class="year-month"><view class="month-title">{{month.label}}</view><view class="weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="days"><view wx:for="{{month.cells}}" wx:for-item="day" wx:key="key" class="day {{day.blank ? 'blank' : ''}} {{day.outside ? 'outside' : ''}} {{day.selected ? 'selected-day' : ''}}" style="background:{{day.color}}" data-date="{{day.date}}" data-key="{{cityKey}}" bindtap="{{day.blank || day.outside ? 'noop' : 'dayTap'}}" role="button" aria-label="{{day.label}}"></view></view></view></view></template>
<template name="screen">
 <view class="app-header" style="padding-top:{{navTop}}px;height:{{navTop + navHeight}}px"><view class="brand"><view class="brand-mark"><view wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this"></view></view><text>城市 AQI 年度概览</text></view></view>
 <view class="header-spacer" style="height:{{navTop + navHeight}}px"></view>
 <view class="page">
  <view class="meta-row"><text class="period">● {{period}}</text><view class="manage-link" bindtap="openManager">☰ 管理城市</view></view>
  <view class="source-line">AQI.in · AQI-US</view>
  <view wx:if="{{mode !== 'realtime' && !empty}}" class="live-strip"><text class="live-label" bindtap="goRealtime">{{liveLabel}}</text><scroll-view scroll-x class="live-scroll" show-scrollbar="{{false}}"><view class="live-inline"><view wx:for="{{live}}" wx:key="key" class="live-item"><text>{{item.name}}</text><text class="live-number" style="color:{{item.color}}">{{item.value}}{{item.stale ? '*' : ''}}</text></view></view></scroll-view></view>
  <view wx:if="{{error}}" class="data-status">{{error}}。当前显示已保存数据。<text bindtap="onPullDownRefresh" class="retry">重试</text></view>
  <view wx:if="{{busy}}" class="loading-line">正在更新数据…</view>
  <view wx:if="{{empty && mode !== 'compare'}}" class="empty-state"><view>尚未选择城市</view><text>点击“管理城市”选择城市开始对比。</text></view>
  <block wx:if="{{mode === 'calendar' && !empty}}">
   <template is="legend" data="{{legend:legend}}"/><view class="section-title">城市日历</view>
   <view wx:for="{{cards}}" wx:for-item="city" wx:key="key" class="city-card">
    <view class="city-name">{{city.name}}</view><view class="english">{{city.english}} / {{city.province}}</view>
    <view class="annual-stats"><view><text class="stat-label">有值日期 AQI 均值</text><text class="stat-value">{{city.stats.average}}</text></view><view><text class="stat-label">AQI ≤ 100 天数</text><text class="stat-value">{{city.stats.low}}</text><text class="stat-unit">/ {{city.stats.valid}} 天</text></view><view><text class="stat-label">AQI ＞ 100 天数</text><text class="stat-value">{{city.stats.high}}</text><text class="stat-unit">天</text></view><view><text class="stat-label">最高日值</text><text class="stat-value">{{city.stats.maximum}}</text></view></view>
    <template is="months" data="{{months:city.months,weekdays,cityKey:city.key}}"/>
    <view class="distribution"><view wx:for="{{city.distribution}}" wx:key="index" style="width:{{item.width}}%;background:{{item.color}}"></view></view>
   </view>
   <view wx:if="{{cards.length < selectedCount}}" class="load-more" bindtap="onReachBottom">继续查看其他城市</view>
  </block>
  <block wx:if="{{mode === 'realtime' && !empty}}"><view class="section-title">{{today}} · {{liveLabel}}</view><view class="live-cards"><view wx:for="{{live}}" wx:key="key" class="live-card" style="border-color:{{item.border}};background:{{item.background}}"><text>{{item.name}}</text><text class="realtime-value" style="color:{{item.color}}">{{item.value}}</text><text class="realtime-time">{{item.status}} {{item.time}}</text></view></view></block>
  <view wx:if="{{mode === 'monthly' && !empty}}" class="panel monthly-panel"><view class="section-title">城市 × 月份</view><view class="segmented"><view class="{{metric === 'median' ? 'chosen' : ''}}" data-metric="median" bindtap="setMetric">月度 AQI 中位数</view><view class="{{metric === 'good-share' ? 'chosen' : ''}}" data-metric="good-share" bindtap="setMetric">良好日占比</view></view>
   <view class="month-layout"><view class="month-fixed"><view class="matrix-heading">月份 / 城市</view><view wx:for="{{monthRows}}" wx:key="key" class="matrix-label">{{item.label}}</view></view><scroll-view scroll-x class="matrix-scroll" show-scrollbar="{{false}}"><view class="matrix-content" style="width:{{(monthCities.length + monthBlanks.length) * 176}}rpx"><view class="matrix-line matrix-heading"><view wx:for="{{monthCities}}" wx:key="key" class="matrix-city">{{item.name}}</view><view wx:for="{{monthBlanks}}" wx:key="*this" class="matrix-city"></view></view><view wx:for="{{monthRows}}" wx:for-item="month" wx:key="key" class="matrix-line"><view wx:for="{{month.cells}}" wx:key="key" class="matrix-cell" style="background:{{item.color}}"><text>{{item.value}}</text><text wx:if="{{item.count}}" class="matrix-count">{{item.count}}</text></view><view wx:for="{{monthBlanks}}" wx:key="*this" class="matrix-cell matrix-blank"></view></view></view></scroll-view></view><template wx:if="{{metric === 'median'}}" is="legend" data="{{legend:legend}}"/>
  </view>
  <view wx:if="{{mode === 'statistics' && !empty}}" class="panel"><view class="chart-heading"><view class="section-title">日值分布 · 低 AQI 日子占多少</view><text bindtap="resetFocus" class="small-link">显示全部</text></view><scroll-view scroll-x class="series-scroll"><view class="series-inline"><view wx:for="{{series}}" wx:key="key" class="series-key {{item.active ? 'series-active' : ''}}" data-key="{{item.key}}" bindtap="focusSeries"><view class="series-swatch" style="background:{{item.color}}"></view><text>{{item.name}}</text></view></view></scroll-view><aqi-chart spec="{{ecdf}}" height="290"/>
   <view class="threshold"><text>查看 AQI ≤ {{threshold}}</text><slider min="0" max="200" step="1" value="{{threshold}}" activeColor="#2779ad" block-size="20" bindchanging="setThreshold" bindchange="setThreshold"/></view><view class="presets"><view data-value="50" bindtap="preset">良好 ≤50</view><view data-value="100" bindtap="preset">≤100</view><picker range="{{['默认顺序','占比从高到低','占比从低到高']}}" bindchange="sortShares"><view>排序 ▾</view></picker></view>
   <view class="share-cards"><view wx:for="{{shares}}" wx:key="key" class="share-card" data-key="{{item.key}}" bindtap="focusSeries"><view><text style="color:{{item.color}}">● </text>{{item.name}}</view><text class="share-value">{{item.share}}</text><text class="share-count">{{item.count}} / {{item.total}} 个有效日</text></view></view>
  </view>
  <block wx:if="{{mode === 'compare'}}">
   <view class="pair-picker"><text class="a-label">城市 A</text><picker range="{{pairCities}}" value="{{aIndex}}" bindchange="pickA"><view class="picker-button">{{aName}} ▾</view></picker><view class="swap" bindtap="swap">⇄</view><text class="b-label">城市 B</text><picker range="{{pairCities}}" value="{{bIndex}}" bindchange="pickB"><view class="picker-button">{{bName}} ▾</view></picker><text class="pair-count">共同已发布日期 {{pairCount}} 天 / 区间 365 天</text></view>
   <view wx:if="{{noPair}}" class="empty-state"><view>暂无共同有效日期</view><text>请选择两座有历史数据的城市。</text></view>
   <block wx:else><view class="takeaway">{{takeaway}}</view><view class="pair-stats"><view wx:for="{{pairStats}}" wx:key="label" class="pair-stat"><text class="stat-label">{{item.label}}</text><text class="pair-value">{{item.value}}</text><text class="stat-unit">{{item.sub}}</text></view></view>
    <view class="panel"><view class="section-title">差值日历</view><view class="subtitle">每格 A − B，数值越接近 0，颜色越浅</view><template is="months" data="{{months:deltaMonths,weekdays,cityKey:'pair'}}"/><view class="delta-legend"><view class="delta-labels"><text>蓝：{{aName}}低于{{bName}}</text><text>橙：{{aName}}高于{{bName}}</text></view><view class="delta-ramp"></view><view class="delta-scale"><text>−{{deltaLimit}}</text><text>0（相同）</text><text>+{{deltaLimit}}</text></view><view class="legend-item"><view class="missing-swatch"></view><text>灰色：未配对</text></view></view></view>
    <view class="panel"><view class="section-title">月度差距</view><view class="subtitle">每月仅用两城共同有效日期</view><view class="pair-legend"><text class="a-label">● {{aName}}</text><text class="b-label">● {{bName}}</text></view><aqi-chart spec="{{monthlyGap}}" height="420"/></view>
    <view class="panel"><view class="section-title">日值分布</view><view class="pair-legend"><text class="a-label">● {{aName}}</text><text class="b-label">● {{bName}}</text></view><aqi-chart spec="{{pairEcdf}}" height="290"/><view class="threshold"><text>查看 AQI ≤ {{threshold}}</text><slider min="0" max="200" value="{{threshold}}" activeColor="#2779ad" block-size="20" bindchanging="setThreshold" bindchange="setThreshold"/></view><view class="presets"><view data-value="50" bindtap="preset">良好 ≤50</view><view data-value="100" bindtap="preset">≤100</view></view><view class="pair-share">{{pairShare}}</view></view>
   </block>
  </block>
  <view class="notes"><view bindtap="toggleNotes">{{notes ? '▾' : '▸'}} {{mode === 'compare' ? '统计口径' : '数据来源与口径 · AQI.in · AQI-US'}}</view><view wx:if="{{notes}}" class="notes-copy"><text>数据来源：AQI.in，美标 AQI-US。统计区间 {{period}}，缺失不填补。</text><text>实时数据独立展示，不计入历史日值统计；快照和过期缓存会单独标注。</text><text>月度统计使用所选城市共同有效日期；良好指 AQI ≤ 50。</text><text wx:if="{{mode === 'compare'}}">仅比较两城共同有效日期，差值为 A − B；差值色标以 0 对称，所有城市共用刻度。</text></view></view><view wx:if="{{!empty}}" class="export" bindtap="exportData">↓ 导出所选城市</view>
 </view>
 <view wx:if="{{manager}}" class="overlay"><view class="mask" bindtap="closeManager"></view><view class="manager-sheet"><view class="sheet-handle"></view><view class="sheet-title"><text>对比城市</text><text class="selected-count">已选 {{selectedCount}} / {{totalCount}}</text><text class="close" bindtap="closeManager">×</text></view><view class="manager-actions"><text bindtap="allCities">全选</text><text bindtap="clearCities">清空</text></view><view class="search-box"><input placeholder="搜索城市或地区，支持中英文" value="{{query}}" bindinput="searchInput" bindconfirm="searchCities"/><view bindtap="searchCities">搜索</view></view><scroll-view scroll-y class="manager-scroll"><view wx:if="{{searching}}" class="search-message">正在搜索…</view><view wx:if="{{searchError}}" class="search-message">{{searchError}}</view><view wx:for="{{searchRows}}" wx:key="key" class="search-result"><view><text>{{item.name}}</text><text class="search-province">{{item.province}}{{item.region ? ' · 地区' : ''}}</text></view><view bindtap="addSearchCity" data-key="{{item.key}}">{{item.region ? '下辖城市' : item.selected ? '已选择' : '添加'}}</view></view><view class="manager-grid"><view wx:for="{{available}}" wx:key="key" class="manager-chip {{item.selected ? 'is-selected' : ''}} {{dragKey === item.key ? 'is-dragging' : ''}}"><view class="city-toggle" data-key="{{item.key}}" bindtap="toggleCity"><view class="check">{{item.selected ? '✓' : ''}}</view><text>{{item.name}}</text></view><view class="drag-handle" data-key="{{item.key}}" catchtouchstart="startDrag" catchtouchmove="dragMove" catchtouchend="endDrag" catchtouchcancel="endDrag">⠿</view><view class="delete" data-key="{{item.key}}" bindtap="deleteCity">×</view></view></view></scroll-view><view class="sheet-footer">{{busy ? '正在更新数据…' : '已选择城市将在打开小程序时尝试更新'}}</view></view></view>
 <view wx:if="{{popup}}" class="popup-layer"><view class="popup-mask" bindtap="closePopup"></view><view class="day-popup"><view class="popup-title">{{popup.title}}<text class="close" bindtap="closePopup">×</text></view><view wx:for="{{popup.lines}}" wx:key="*this">{{item}}</view></view></view>
</template>
